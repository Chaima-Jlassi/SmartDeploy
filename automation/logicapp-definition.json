{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "githubToken": {
        "type": "securestring"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "alerts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "labels": {
                      "type": "object",
                      "properties": {
                        "alertname": { "type": "string" },
                        "severity": { "type": "string" },
                        "app": { "type": "string" },
                        "namespace": { "type": "string" }
                      }
                    }
                  }
                }
              }
            },
            "required": ["alerts"]
          }
        }
      }
    },
    "actions": {
      "For_each_alert": {
        "type": "Foreach",
        "foreach": "@triggerBody()?['alerts']",
        "actions": {
          "Is_valid_critical_service_alert": {
            "type": "If",
            "expression": {
              "and": [
                { "equals": ["@items('For_each_alert')?['status']", "firing"] },
                { "equals": ["@items('For_each_alert')?['labels']?['alertname']", "HighErrorRate"] },
                { "equals": ["@items('For_each_alert')?['labels']?['severity']", "critical"] },
                {
                  "or": [
                    {
                      "and": [
                        { "equals": ["@items('For_each_alert')?['labels']?['app']", "product-catalog"] },
                        {
                          "or": [
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "dev"] },
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "staging"] },
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "prod"] }
                          ]
                        }
                      ]
                    },
                    {
                      "and": [
                        { "equals": ["@items('For_each_alert')?['labels']?['app']", "order-service"] },
                        {
                          "or": [
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "dev"] },
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "staging"] },
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "prod"] }
                          ]
                        }
                      ]
                    },
                    {
                      "and": [
                        { "equals": ["@items('For_each_alert')?['labels']?['app']", "notification-service"] },
                        {
                          "or": [
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "dev"] },
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "staging"] },
                            { "equals": ["@items('For_each_alert')?['labels']?['namespace']", "prod"] }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "actions": {
              "Dispatch_GitOps_rollback": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://api.github.com/repos/Chaima-Jlassi/SmartDeploy/dispatches",
                  "headers": {
                    "Accept": "application/vnd.github+json",
                    "Authorization": "@{concat('Bearer ', parameters('githubToken'))}",
                    "Content-Type": "application/json",
                    "X-GitHub-Api-Version": "2022-11-28"
                  },
                  "body": {
                    "event_type": "smartdeploy_rollback",
                    "client_payload": {
                      "service": "@items('For_each_alert')?['labels']?['app']",
                      "namespace": "@items('For_each_alert')?['labels']?['namespace']",
                      "alertname": "@items('For_each_alert')?['labels']?['alertname']"
                    }
                  },
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {}
          }
        },
        "operationOptions": "Sequential",
        "runAfter": {}
      },
      "Response": {
        "type": "Response",
        "inputs": {
          "statusCode": "@if(equals(actions('For_each_alert')?['status'], 'Succeeded'), 202, 502)",
          "body": {
            "status": "Alert batch accepted; only validated firing HighErrorRate alerts are dispatched."
          }
        },
        "runAfter": {
          "For_each_alert": ["Succeeded", "Failed"]
        }
      }
    }
  }
}
